function sourcefile(){
	source $1
	echo "sourced '$1' file"
}
function editandsource(){
	nvim $1
	sourcefile $1
}
alias esfile="editandsource"
function cdeditandsource(){
  DIRECTORY=$(pwd)
  cd $1
  nvim $1/$2
  sourcefile $1/$2
  cd $DIRECTORY
}

function nvimfolder(){
  DIRECTORY=$(pwd)
  cd $1
  nvim
  cd $DIRECTORY
}

